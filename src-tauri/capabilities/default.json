{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "oauth:allow-start",
    "dialog:allow-open",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "/**"}]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "/**"}]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "/**"}]
    }
  ]
}